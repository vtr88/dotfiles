#!/usr/bin/env bash
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
backup_dir="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"

sudo apt update
sudo apt install --no-install-recommends \
    ca-certificates \
    build-essential \
    libcairo2-dev \
    libcrypt-dev \
    libfontconfig1-dev \
    libfreetype-dev \
    chafa \
    cmatrix \
    curl \
    diodon \
    dunst \
    feh \
    firefox-esr \
    ffmpegthumbnailer \
    flameshot \
    fonts-firacode \
    fonts-roboto \
    git \
    irssi \
    isync \
    libc6-dev \
    libglib2.0-dev \
    libimlib2-dev \
    libx11-dev \
    libxdo-dev \
    libxext-dev \
    libxft-dev \
    libxinerama-dev \
    libxrandr-dev \
    libxrender-dev \
    libxtst-dev \
    lbdb \
    lf \
    btop \
    neomutt \
    neovim \
    network-manager-gnome \
    newsboat \
    papirus-icon-theme \
    picom \
    pipewire-jack \
    pkg-config \
    policykit-1-gnome \
    python3-bs4 \
    python3-requests \
    taskwarrior \
    tmux \
    ueberzug \
    urlscan \
    volumeicon-alsa \
    wireguard-tools \
    x11-xserver-utils \
    xarchiver \
    xboard \
    xclip \
    xdotool \
    xfce4-power-manager \
    xsettingsd \
    xinit \
    xorg \
    fzf \
    zoxide \
    zsh

for package in aseprite chatgpt spotify-client; do
    if apt-cache show "$package" >/dev/null 2>&1; then
        sudo apt install --no-install-recommends "$package"
    else
        printf 'Optional package %s is unavailable; see README.md.\n' "$package"
    fi
done

backup_target() {
    target=$1

    if [ -e "$target" ] || [ -L "$target" ]; then
        mkdir -p "$backup_dir/$(dirname "${target#$HOME/}")"
        cp -a "$target" "$backup_dir/${target#$HOME/}"
    fi
}

install_path() {
    src=$1
    dest=$HOME/$src

    backup_target "$dest"
    mkdir -p "$(dirname "$dest")"

    if [ -d "$repo_dir/$src" ]; then
        mkdir -p "$dest"
        cp -a "$repo_dir/$src/." "$dest/"
    else
        cp -a "$repo_dir/$src" "$dest"
    fi
}

install_firefox_theme() {
    profiles_ini=$HOME/.mozilla/firefox/profiles.ini

    if [ ! -f "$profiles_ini" ]; then
        printf 'Firefox profile not found; skipping Gruvwood browser theme.\n'
        return
    fi

    profile_path=$(awk -F= '
        /^\[Install/ { in_install = 1; next }
        /^\[/ { in_install = 0 }
        in_install && $1 == "Default" { print $2; exit }
    ' "$profiles_ini")

    if [ -z "$profile_path" ]; then
        profile_path=$(awk -F= '
            /^\[Profile/ { in_profile = 1; path = ""; is_default = 0; next }
            /^\[/ {
                if (in_profile && is_default && path != "") {
                    print path
                    exit
                }
                in_profile = 0
            }
            in_profile && $1 == "Path" { path = $2 }
            in_profile && $1 == "Default" && $2 == "1" { is_default = 1 }
            END {
                if (in_profile && is_default && path != "") {
                    print path
                }
            }
        ' "$profiles_ini")
    fi

    if [ -z "$profile_path" ]; then
        printf 'Firefox default profile not found; skipping Gruvwood browser theme.\n'
        return
    fi

    case "$profile_path" in
        /*) profile_dir=$profile_path ;;
        *)  profile_dir=$HOME/.mozilla/firefox/$profile_path ;;
    esac

    backup_target "$profile_dir/chrome"
    backup_target "$profile_dir/user.js"
    mkdir -p "$profile_dir/chrome"
    cp -a "$repo_dir/.config/firefox-gruvwood/chrome/." "$profile_dir/chrome/"
    cp -a "$repo_dir/.config/firefox-gruvwood/user.js" "$profile_dir/user.js"
}

install_desktop_tools() {
    tools_dir=${SUCKLESS_DIR:-"$HOME/Documentos/c/suckless"}

    if [ ! -d "$tools_dir/.git" ]; then
        if [ -e "$tools_dir" ]; then
            printf 'Cannot clone tools: %s exists and is not a Git repository.\n' "$tools_dir" >&2
            exit 1
        fi
        mkdir -p "$(dirname "$tools_dir")"
        git clone https://github.com/vtr88/suckless.git "$tools_dir"
    fi

    for tool in dmenu dwm slock slstatus st; do
        if ! cmp -s "$tools_dir/$tool/config.h" "$tools_dir/$tool/config.def.h"; then
            printf '%s config.h and config.def.h differ; refusing to build.\n' "$tool" >&2
            exit 1
        fi
        make -C "$tools_dir/$tool" clean all
        sudo make -C "$tools_dir/$tool" install
    done

    make -C "$tools_dir/keynav" clean all
    sudo make -C "$tools_dir/keynav" PREFIX=/usr/local install
}

paths='
.Xresources
.xinitrc
.zshrc
.config/.task
.config/aseprite
.config/dunst
.config/feh
.config/git
.config/greek.sh
.config/gtk-3.0
.config/irssi
.config/keynav
.config/lf
.config/mimeapps.list
.config/mutt
.config/newsboat
.config/nvim
.config/mpv
.config/picom
.config/Renoise
.config/spicetify/Themes/Gruvwood
.config/stylus/Gruvwood
.config/tmux
.gtkrc-2.0
.nethackrc
.nethackrcx11
.themes/Gruvbox
'

for path in $paths; do
    install_path "$path"
done

install_firefox_theme
install_desktop_tools

aseprite_ini=$HOME/.config/aseprite/aseprite.ini
if [ -f "$aseprite_ini" ]; then
    sed -i '/^\[theme\]$/,/^\[/ s/^selected = .*/selected = Gruvwood/' "$aseprite_ini"
fi

chmod +x "$HOME/.xinitrc" "$HOME/.config/greek.sh" || true
chmod +x "$HOME/.config/lf/preview" "$HOME/.config/lf/cleaner" "$HOME/.config/lf/lfub" || true
chmod +x "$HOME/.config/Renoise/apply-desktop-settings" || true

printf '\nInstalled dotfiles into %s\n' "$HOME"
printf 'Backups, if any, were written to %s\n' "$backup_dir"
printf 'Private mail, Newsboat and Irssi credentials are not tracked. Restore them locally after install.\n'
printf 'Close Renoise, then run ~/.config/Renoise/apply-desktop-settings after its first launch.\n'
printf 'Optional proprietary applications may require the external APT sources documented in README.md.\n'

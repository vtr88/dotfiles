#!/usr/bin/env bash
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
backup_dir="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"

sudo apt update
sudo apt install --no-install-recommends \
    ca-certificates \
    chafa \
    cmatrix \
    curl \
    diodon \
    dunst \
    feh \
    firefox-esr \
    ffmpegthumbnailer \
    flameshot \
    fonts-firacode \
    fonts-roboto \
    git \
    irssi \
    isync \
    keynav \
    lbdb \
    lightdm \
    lightdm-gtk-greeter \
    lf \
    neomutt \
    neovim \
    network-manager-gnome \
    newsboat \
    nethack-console \
    nethack-x11 \
    papirus-icon-theme \
    pcmanfm \
    picom \
    policykit-1-gnome \
    python3-bs4 \
    python3-requests \
    taskwarrior \
    tmux \
    ueberzug \
    urlscan \
    volumeicon-alsa \
    wireguard-tools \
    x11-xserver-utils \
    xarchiver \
    xboard \
    xdotool \
    xfce4-power-manager \
    xsettingsd \
    zsh

backup_target() {
    target=$1

    if [ -e "$target" ] || [ -L "$target" ]; then
        mkdir -p "$backup_dir/$(dirname "${target#$HOME/}")"
        cp -a "$target" "$backup_dir/${target#$HOME/}"
    fi
}

install_path() {
    src=$1
    dest=$HOME/$src

    backup_target "$dest"
    mkdir -p "$(dirname "$dest")"
    cp -a "$repo_dir/$src" "$dest"
}

paths='
.Xresources
.xinitrc
.zshrc
.config/.task
.config/dunst
.config/feh
.config/git
.config/greek.sh
.config/gtk-3.0
.config/irssi
.config/lf
.config/mimeapps.list
.config/mutt
.config/newsboat
.config/nvim
.config/picom
.config/tmux
.gtkrc-2.0
.keynavrc
.nethackrc
.nethackrcx11
.themes/Gruvbox
'

for path in $paths; do
    install_path "$path"
done

chmod +x "$HOME/.xinitrc" "$HOME/.config/greek.sh" || true
chmod +x "$HOME/.config/lf/preview" "$HOME/.config/lf/cleaner" "$HOME/.config/lf/lfub" || true

printf '\nInstalled dotfiles into %s\n' "$HOME"
printf 'Backups, if any, were written to %s\n' "$backup_dir"
printf 'Mail sync credentials are intentionally not tracked. Restore private mbsync config locally after install.\n'

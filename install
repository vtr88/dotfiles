#!/usr/bin/env bash
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
backup_dir="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"

sudo apt update
sudo apt install --no-install-recommends \
    alacritty \
    bash-completion \
    ca-certificates \
    cmatrix \
    curl \
    diodon \
    dunst \
    firefox-esr \
    fonts-firacode \
    fonts-roboto \
    git \
    irssi \
    isync \
    keynav \
    lbdb \
    lightdm \
    lightdm-gtk-greeter \
    neomutt \
    neovim \
    network-manager-gnome \
    newsboat \
    nethack-console \
    nethack-x11 \
    nitrogen \
    openbox \
    papirus-icon-theme \
    pcmanfm \
    picom \
    policykit-1-gnome \
    python3-bs4 \
    python3-requests \
    rofi \
    rxvt-unicode \
    taskwarrior \
    tint2 \
    tmux \
    urlscan \
    volumeicon-alsa \
    wireguard-tools \
    x11-xserver-utils \
    xarchiver \
    xboard \
    xdotool \
    xfce4-power-manager \
    xsettingsd

backup_target() {
    target=$1

    if [ -e "$target" ] || [ -L "$target" ]; then
        mkdir -p "$backup_dir/$(dirname "${target#$HOME/}")"
        cp -a "$target" "$backup_dir/${target#$HOME/}"
    fi
}

install_path() {
    src=$1
    dest=$HOME/$src

    backup_target "$dest"
    mkdir -p "$(dirname "$dest")"
    cp -a "$repo_dir/$src" "$dest"
}

paths='
.Xresources
.bash_profile
.bashrc
.config/.task
.config/alacritty
.config/dunst
.config/git
.config/greek.sh
.config/gtk-3.0
.config/irssi
.config/mimeapps.list
.config/mutt
.config/newsboat
.config/nvim
.config/openbox
.config/picom
.config/rofi
.config/tint2
.config/tmux
.config/urxvtext
.gtkrc-2.0
.keynavrc
.nethackrc
.nethackrcx11
.themes/Gruvbox
'

for path in $paths; do
    install_path "$path"
done

chmod +x "$HOME/.config/greek.sh" "$HOME/.config/tint2/bicho.py" || true
chmod +x "$HOME/.config/urxvtext/font-size" "$HOME/.config/urxvtext/font-zoom" "$HOME/.config/urxvtext/resize-font" || true

printf '\nInstalled dotfiles into %s\n' "$HOME"
printf 'Backups, if any, were written to %s\n' "$backup_dir"
printf 'Mail, IRC, and private feed credentials are intentionally REDACTED in this repo. Restore private values locally after install.\n'

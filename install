#!/usr/bin/env bash
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
backup_dir="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"

sudo apt update
sudo apt install --no-install-recommends \
    ca-certificates \
    chafa \
    cmatrix \
    curl \
    diodon \
    dunst \
    feh \
    firefox-esr \
    ffmpegthumbnailer \
    flameshot \
    fonts-firacode \
    fonts-roboto \
    git \
    irssi \
    isync \
    keynav \
    lbdb \
    lf \
    btop \
    neomutt \
    neovim \
    network-manager-gnome \
    newsboat \
    papirus-icon-theme \
    picom \
    policykit-1-gnome \
    python3-bs4 \
    python3-requests \
    taskwarrior \
    tmux \
    ueberzug \
    urlscan \
    volumeicon-alsa \
    wireguard-tools \
    x11-xserver-utils \
    xarchiver \
    xboard \
    xdotool \
    xfce4-power-manager \
    xsettingsd \
    fzf \
    zoxide \
    zsh

backup_target() {
    target=$1

    if [ -e "$target" ] || [ -L "$target" ]; then
        mkdir -p "$backup_dir/$(dirname "${target#$HOME/}")"
        cp -a "$target" "$backup_dir/${target#$HOME/}"
    fi
}

install_path() {
    src=$1
    dest=$HOME/$src

    backup_target "$dest"
    mkdir -p "$(dirname "$dest")"

    if [ -d "$repo_dir/$src" ]; then
        mkdir -p "$dest"
        cp -a "$repo_dir/$src/." "$dest/"
    else
        cp -a "$repo_dir/$src" "$dest"
    fi
}

install_firefox_theme() {
    profiles_ini=$HOME/.mozilla/firefox/profiles.ini

    if [ ! -f "$profiles_ini" ]; then
        printf 'Firefox profile not found; skipping Gruvwood browser theme.\n'
        return
    fi

    profile_path=$(awk -F= '
        /^\[Install/ { in_install = 1; next }
        /^\[/ { in_install = 0 }
        in_install && $1 == "Default" { print $2; exit }
    ' "$profiles_ini")

    if [ -z "$profile_path" ]; then
        profile_path=$(awk -F= '
            /^\[Profile/ { in_profile = 1; path = ""; is_default = 0; next }
            /^\[/ {
                if (in_profile && is_default && path != "") {
                    print path
                    exit
                }
                in_profile = 0
            }
            in_profile && $1 == "Path" { path = $2 }
            in_profile && $1 == "Default" && $2 == "1" { is_default = 1 }
            END {
                if (in_profile && is_default && path != "") {
                    print path
                }
            }
        ' "$profiles_ini")
    fi

    if [ -z "$profile_path" ]; then
        printf 'Firefox default profile not found; skipping Gruvwood browser theme.\n'
        return
    fi

    case "$profile_path" in
        /*) profile_dir=$profile_path ;;
        *)  profile_dir=$HOME/.mozilla/firefox/$profile_path ;;
    esac

    backup_target "$profile_dir/chrome"
    backup_target "$profile_dir/user.js"
    mkdir -p "$profile_dir/chrome"
    cp -a "$repo_dir/.config/firefox-gruvwood/chrome/." "$profile_dir/chrome/"
    cp -a "$repo_dir/.config/firefox-gruvwood/user.js" "$profile_dir/user.js"
}

paths='
.Xresources
.xinitrc
.zshrc
.config/.task
.config/aseprite/extensions/gruvwood-theme
.config/dunst
.config/feh
.config/git
.config/greek.sh
.config/gtk-3.0
.config/irssi
.config/keynav
.config/lf
.config/mimeapps.list
.config/mutt
.config/newsboat
.config/nvim
.config/picom
.config/Renoise/V3.5.4/Themes/Gruvwood.xrnc
.config/spicetify/Themes/Gruvwood
.config/stylus/Gruvwood
.config/tmux
.gtkrc-2.0
.nethackrc
.nethackrcx11
.themes/Gruvbox
'

for path in $paths; do
    install_path "$path"
done

install_firefox_theme

aseprite_ini=$HOME/.config/aseprite/aseprite.ini
if [ -f "$aseprite_ini" ]; then
    sed -i '/^\[theme\]$/,/^\[/ s/^selected = .*/selected = Gruvwood/' "$aseprite_ini"
fi

chmod +x "$HOME/.xinitrc" "$HOME/.config/greek.sh" || true
chmod +x "$HOME/.config/lf/preview" "$HOME/.config/lf/cleaner" "$HOME/.config/lf/lfub" || true

printf '\nInstalled dotfiles into %s\n' "$HOME"
printf 'Backups, if any, were written to %s\n' "$backup_dir"
printf 'Mail sync credentials are intentionally not tracked. Restore private mbsync config locally after install.\n'

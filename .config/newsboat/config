#include /usr/share/doc/newsboat/contrib/colorschemes/kinda-maia
#browser "surf -F -z 1.5"
browser "/home/soth/.config/newsboat/open-url"
max-items 34
auto-reload yes
macro v set browser "setsid -f mpv --no-fullscreen --geometry=640x480 --ytdl-format='bv*[height<=480]+ba/b[height<=480]/b' --script-opts=ytdl_hook-ytdl_path=yt-dlp" ; open-in-browser ; set browser
macro c set browser "setsid -f mpv" ; one ; set browser
macro x set browser "surf -F -z 1.5"
#color background          color223   color0
#color listnormal          color223   color0
#color listnormal_unread   color50    color236 
#color listfocus           color14    color236   
#color listfocus_unread    color50    color236   bold
#color info                color14    color238
#color article             color14    color0

#color background          color223   default
#color listnormal          color223   default
#color listnormal_unread   color50    default 
#color listfocus           color14    default   
#color listfocus_unread    color50    default   bold
#color info                color14    default
#color article             color14    default


color background default default
color listnormal color7 default
color listnormal_unread color11 default bold
color listfocus color15 color8 bold
color listfocus_unread color15 color8 bold
color info color15 color0 bold
color article color15 default

# highlights
highlight all "---.*---" color11 default bold
highlight feedlist ".*(0/0))" color8 default
highlight article "(^Feed:|^Title:|^Date:|^Link:|^Author:)" color14 default bold
highlight article "https?://[^ ]+" color11 default
highlight article "\\[[0-9][0-9]*\\]" color13 default bold
highlight article "\\[image\\ [0-9]+\\]" color10 default bold
highlight article "\\[embedded flash: [0-9][0-9]*\\]" color10 default bold
highlight article ":.*\\(link\\)$" color14 default
highlight article ":.*\\(image\\)$" color12 default
highlight article ":.*\\(embedded flash\\)$" color13 default

unbind-key j
unbind-key k
bind-key k up
bind-key j down

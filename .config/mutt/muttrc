set realname = "Vitor H. E. Souza"
set from = "user@example.invalid"
set use_from = yes
set envelope_from = yes

set folder = "/home/soth/Mail/contato"
set spoolfile = "+Inbox"

set mail_check = 60

###############
# Pager settings
#
ignore *
unignore From Message-ID Date To Cc Bcc Subject
set pager_stop
unset markers
#bind index G imap-fetch-mail
#macro index G "mbsync -a\n"
macro index,pager G "!mbsync -c /home/soth/.config/mutt/.mbsyncrc contato\n" "Sync mail"

set pgp_use_gpg_agent = yes
set pgp_replyencrypt = yes
set pgp_autosign     = yes
set pgp_sign_as      = 0F0EAB753965CA662AF5A307A999FC79A54C8A4A

# Prefer plain text to html.
# However, for brain dead clients that bundle attachments inside a
# multipart/alternative, prefer that alternative.
alternative_order multipart/mixed multipart/related text/plain

# Consult mime.types for determining types of these attachments
mime_lookup application/octet-stream

# This requires a ~/.mailcap entry with the copiousoutput flag, such as:
# text/html; lynx -dump -width ${COLUMNS:-80} %s; nametemplate=%s.html; copiousoutput
auto_view text/html
set mailcap_path = "/home/soth/.config/mutt/.mailcap"

###############
# Index settings
#
set quit = ask-yes
set sort = reverse-threads
set sort_aux = date-received
#set signature = ~/.sig

###############
# Message composition settings
#
set editor = "nvim"
set mime_type_query_command = "xdg-mime query filetype"

# msmtp is a solid SMTP client.
# mutt also has built-in SMTP, or you can use an MTA like exim4 or postfix.
#set sendmail = "/usr/bin/msmtp"
set ssl_starttls=yes
set ssl_force_tls=yes

set smtp_url = "smtps://user@REDACTED_HOST:465/"
set smtp_pass = "REDACTED"

# Where to save copies of outgoing mail
set record = '+Sent'

# lbdb is a versatile contact query tool.
# Invoke via ctrl-t in an address prompt
set query_command = "/usr/bin/lbdbq"

color attachment  color109 default
color bold        color229 default
color error       color167 default
color hdrdefault  color246 default
color indicator   color223 color237
color markers     color243 default

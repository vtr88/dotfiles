replaces = { ":()" = "%K$*%n"; };
abstracts = {
  line_start = "%K.:";
  timestamp = "%K.:%y$*%K:.%n";
  hilight = "%Y$*%n";
  error = "%r$*%n";
  channel = "%y%_$*%_%n";
  channel2 = "%y$C%n";
  nick = "%c$*%n";
  nickhost = "$*";
  server = "%g$*%n";
  comment = "%K[%n$*%K]%n";
  reason = "%K(%n$*%K)%n";
  mode = "%K<%y%_$*%_%K>%n";
  channick_hilight = "%Y$*%n";
  channick_hilight2 = "%w$*%n";
  chanhost_hilight = "%K<{nickhost $*}%K>%n";
  channick = "%c$*%n";
  chanhost = "%K<%n%c{nickhost $*}%n%K>%n";
  channelhilight = "%y$*%n";
  ban = "$*";
  msgnick = "%n%K$0%c$1-%_%K:%n %|";
  ownmsgnick = "%n%K$0%g$1-%_%K:%n %|";
  ownnick = "%g%_$*%_%n";
  pubmsgnick = "{msgnick $0 $1-}";
  pubnick = "%_$*%_";
  pubmsgmenick = "{msgnick $0 %_$1-%_%n}";
  menick = "%m$*%n";
  pubmsghinick = "{msgnick $1 $0$2-}";
  msgchannel = "%K:%n%y%_$*%_%n";
  privmsg = "%K[%n%m$0%n%K(%n{nickhost $1-}%K)]%n ";
  ownprivmsg = "%K[%n%g%n%K(%c$1-%n%K)]%n ";
  ownprivmsgnick = "%K<%g$*%n%K>%n ";
  ownprivnick = "%_$*%_";
  privmsgnick = "%K<%_%c$*%n%K>%n ";
  action = "%K*%n";
  ownaction = "{action } %g$0%n $1-";
  pvtaction = "%K[%mquery%n(%c$0%n)]%n {action } %K->%n $1-";
  pvtaction_query = "%K*%n $* {action } ";
  pubaction = "{action } %m$*%n";
  whois = "$[12]0 : $1-";
  whois1 = "$[12]0 : $1-";
  whois2 = "$[12]0 : $1-";
  whois3 = "$[12]0 : $1-";
  ownnotice = "%K[%n%gnotice%n%K(%c$1-%n%K)]%n ";
  notice = "%K-%n%y$0%n%K-%n ";
  pubnotice_channel = ":$*";
  pvtnotice_host = "%K(%n%c$*%n%K)%n";
  servernotice = "{notice $*}";
  ownctcp = "%K[%n%g$0%n%K(%c$1-%n%K)]%n ";
  ctcp = "%K>%n>%K>%n {nick $0} %g$1%n $2 %y$3%n $4 $5 %g$6%n";
  wallop = " $*: ";
  wallop_nick = " $*";
  wallop_action = " * $* ";
  netsplit = "%r$*%n";
  netjoin = "%g$*%n";
  names_nick = "%c$0%w$[9]1-%n ";
  names_users = "(%g$0%K(%c$1%K)%n)";
  names_channel = "%y$*%n";
  dcc = "%c$0%n $1 $3 $4 %g$5 $6 $7 $8-%n";
  dccfile = "%_$*%_";
  dccownmsg = "%K[%gdcc%n(%c$*%n)]%n ";
  dccownnick = "%g$*%n";
  dccownaction = "%K[%gdcc%K(%c$0%n)]%n {action } %K->%n $1-";
  dccmsg = "%K[%cdcc%n(%c$*%n)]%n ";
  dccquerynick = "%c$*%n";
  dccaction = "%K[%gdcc%n(%g$*)]%n {action }%n %|";
  sb_background = "%0";
  sb_topic_bg = "%0%y";
  sb = "%K.:%n$0-%K:.%n";
  prompt = "%K<%n%g%_$0%_%n%K>%n ";
  sbmode = "$0-";
  #sbaway = ":%K.%W: %WAway:%n %K'%c$A%K'%n";
  sbservertag = ":$0 %n(%cchange with ^X%n)";
  sbmore = "  %r<%y<%K< %nmore %K>%y>%r>  ";
  sblag = "{sb Lagging %r$0-%K seconds!}";
  sb_default_bg = "%4";
  sb_act_sep = "%K/";
  sb_act_text = "%y$*";
  sb_act_msg = "%c$*";
  sb_act_hilight = "%Y$*";
  sb_act_hilight_color = "$0$1-%n";
  sb_info1_bg = "%n";
  sb_window_bg = "%g%w";
  sb_window2_bg = "%g%w";
  sb_info2_bg = "%n";

  sb_usercount = "{sb %yN%wetwork:%n %K$tag }{sb %yU%wsers: %g$0 %K$1-";
  sb_uc_normal = "%yN%wormal %g$*%K]";
  sb_uc_ops = "%K[%yIRC%wOpers %_%g$mh_opercount :.: %yO%wpers %_%g$*%K :.:";
  sb_uc_voices = "%yV%woice %g$*%K :.:";

};
formats = {
  "fe-common/core" = {
    join = "%Kmode   %gjoin      %K>%g>%G> %n{channick_hilight %g$0} {chanhost_hilight %K$1}";
    part = "%Kmode   %ypart      %K<%y<%Y< %n{channick_hilight2 %w$0} {chanhost_hilight %K$1} {reason $3}";
    kick = "%Kmode   %rKICK      %r<%R<%K< %n{channick_hilight2 %w$0} by {nick $2} {reason $3}";
    quit = "%Kmode   %rQUIT      %r<%R<%K< %n{channick_hilight2 %w$0}%n {chanhost_hilight %K$1}%n {reason $2}";
    quit_once = "{channel $3} {channick $0} {chanhost $1} {reason $2}";
    servertag = "%K[%y$0%K] ";
    invite = "%gInvites %K>%y>%Y> %n{nick $0} to {channel $1}";
    new_topic = "%Kmode   %y#      %K>%y>%Y> %nTopic was changed by {channick $0} in {channel $1} to: $2";
    topic_unset = "%Kmode   %y#   %r<%y<%K< %nTopic for %n{channel $1} unset by %n{channick $0}";
    your_nick_changed = "Your nick %nis now {nick $1}:.";
    nick_changed = "%Kmode   ~   {channick %w$0} %Kis now%n {channick_hilight %w$1}";
    talking_in = "%g You are now talking in {channel $0}";
    not_in_channels = "%r You are not on any channels";
    names = "{names_users %K.:Users:.%n} (channel {names_channel $0}).:(%g$1%n):.";
    names_nick = "{names_nick $0 $1}";
    endofnames = "{channel %w$0}: %wTotal of {hilight %K((%g$1%K))%n} %wnicks%n {comment Ops {hilight %K((%g$2%K))%n}, Voice %K(({hilight %g$4%K))%n, Normal %K(({hilight %g$5%K))%n}";

    pubmsg = "{pubmsgnick $2 {pubnick $0}}$1";
    own_msg = "{ownmsgnick $2 {ownnick $0}}$1";
    own_msg_channel = "{ownmsgnick $3 {ownnick $0}{msgchannel $1}}$2";
    pubmsg_me = "{pubmsgmenick $2 {menick $0}}$1";
    pubmsg_me_channel = "{pubmsgmenick $3 {menick $0}{msgchannel $1}}$2";
    pubmsg_hilight = "{pubmsghinick $0 $3 $1}$2";
    pubmsg_hilight_channel = "{pubmsghinick $0 $4 $1{msgchannel $2}}$3";
    pubmsg_channel = "{pubmsgnick $3 {pubnick $0}{msgchannel $1}}$2";
  };
  "fe-common/irc" = {
    inviting = "%K>%y>%Y>%n Inviting {nick $0} to {channel $1}";
    topic_info = "%Kmode   %nTopic set by {channick $0} {comment $1}";
    server_chanmode_change = "{netsplit %yServerMode%n}/{channelhilight $0} {mode $1} by {nick $2}";
    #whois = "%b- %C--%W+%C-----%W.%coOo%W,%C--<%C(%mxl%C)%C>--%W,%coOo%W.%C----------%W+%C-- %b----%n%:%C*%n {nick $0} ({nickhost $1%R@%n$2}) {comment $4}%:{whois %_i%_rcname $3}";
    whois = "{nick $0} ({nickhost $1%K@%n$2}) {comment $4}%:{whois %_i%_rcname $3}";
    whowas = "           %yWHOWAS%K       %n%:%r*%n {nick $0} ({nickhost $1%K@%n$2})%:{whois %_i%_rcname $3}";
    whois_idle = "{whois3 %_i%_dle %|$1 days $2 hours $3 mins $4 secs}";
    whois_idle_signon = "{whois3 %_i%_dle %|$1 days $2 hours $3 mins $4 secs (signon: $5)}";
    whois_server = "{whois2 %_s%_erver %|$1 ($2)}";
    whois_oper = "{whois3 %_o%_perator {hilight $1}}";
    whois_registered = "{whois %_a%_uth has registered this nick}";
    whois_help = "{whois %_d%_uty is available for help}";
    whois_modes = " {whois %_m%_odes $1}";
    whois_realhost = "{whois %_h%_ostname $1-}";
    whois_usermode = "{whois %_u%_sermode $1}";
    whois_channels = "{whois %_c%_hannels %|$1}";
    #    whois_away = "{whois %_a%_way %|$1}";
    whois_away = "{whois %_a%_way %y%|$1}";
    whois_special = "{whois  %|{hilight $1}}";
    end_of_whois = "%yEnd of WHOIS:.%n";
    end_of_whowas = "%wEnd of WHOWAS:.";
    whois_not_found = "%wThere is no such Nick:%r.%w {nick %w$0}";
    who = "{channelhilight %c$[!10]0%n} %|{nick $[!9]1} %c$[!3]2%n $[!2]3 $4%K@%n$5 :: $6";
    ctcp_requested = "requested $2 from {nick $3} {ctcp {hilight $0} {comment $1}}";

  };
  "fe-common/irc/dcc" = {
    own_dcc = "{dccownmsg {dccownnick $1}}$2";
    own_dcc_action = "{dccownaction_target $0 $1}$2";
    own_dcc_action_query = "{dccownaction $0}$2";
    own_dcc_ctcp = "{ownctcp ctcp $0}$1 $2";
    dcc_msg = "{dccmsg $0}$1";
    action_dcc = "{dccaction $0}$1";
    action_dcc_query = "{dccaction $0}$1";
    own_dcc_query = "{dccownmsg {dccownnick $0}}$2";
    dcc_msg_query = "{dccmsg $0}$1";
    dcc_ctcp = "{dcc >>> DCC CTCP {hilight $1} received from {hilight $0}: $2}";
  };
  "Irssi::Script::country" = {
    whois = "%b- %C--%W+%C-----%W.%coOo%W,%C--<%C(%WA%C)_(%WA%C)%C>--%W,%coOo%W.%C----------%W+%C-- %b----%n%:%C*%n {nick $0} ({nickhost $1%R@%n$2}) {comment $4}%:{whois %_i%_rcname $3}";
    whowas = "%b.%B.%C...........................................%n%:%G|%n {nick $0} ({nickhost $1%R@%n$2}) {comment $4}%:{whois %_i%_rcname $3}";
  };
};
